# --- App ---
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@db:5432/portfolio
APP_ENV=dev

# --- Метрики (v2, docs/v2/02-m1-discovery-scoring-spec.md) ---
# Ahrefs API v3: бесплатный DR на входе discovery, batch-analysis (W4) и анкоры (W6) — units в
# месяце ограничены, капы и пол остатка — на /settings. Ключ — свой, не MCP-коннектор чата.
AHREFS_API_KEY=

# --- SERP: SearXNG (локально, free) — заменяет платный SERP-API ---
SEARXNG_URL=http://192.168.1.77:8080

# --- A-Parser (локально): whois / SERP-фолбэк / keywords ---
APARSER_URL=http://192.168.1.77:9091
APARSER_API_KEY=                  # API-пароль A-Parser
APARSER_PROXY_CHECKER=    # имя Proxy Checker в A-Parser UI (default: Free Proxy 2) — box-specific

# --- backorder.ru (выкуп M2 до подпроекта 2; в discovery v2 не используется) ---
BACKORDER_LOGIN=
BACKORDER_PASSWORD=
BACKORDER_ACCOUNT_ID=
BACKORDER_CONTACT_ID=

# --- optimizator.ru (регистрация освободившихся, M2) ---
OPTIMIZATOR_API_KEY=
OPTIMIZATOR_NICD=

# --- Риск W3: Google Web Risk (без ключа — «риск не проверен») + Spamhaus DBL только с DQS ---
DNS_RESOLVER=172.28.0.53          # unbound из docker-compose.yml (сеть combine); пусто = системный
SPAMHAUS_DQS_KEY=                 # DQS-ключ: без него Spamhaus в воронке не зовётся (зеркало для коммерции запрещено)
WEBRISK_API_KEY=

# --- NameSilo (M2 выкуп международных зон + смена NS на Cloudflare в M3) ---
# namesilo.com → Account → API Manager → Generate. Канал «registrar» в таблице зона→канал (/settings).
# Регистрация синхронная: успех = домен purchased, карточка сайта создаётся сама; NS Cloudflare
# провижн записывает сам (changeNameServers). Все поля можно задать и на /settings/keys.
NAMESILO_API_KEY=
NAMESILO_SANDBOX=false            # true — sandbox.namesilo.com (ключ песочницы отдельный)
NAMESILO_CONTACT_ID=              # contact_id профиля регистранта; пусто — профиль по умолчанию
NAMESILO_ALLOW_PREMIUM=false      # премиум-домены (цена в десятки раз выше) — только явно

# --- Cloudflare (M3) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- aaPanel (M3 провижн) ---
AAPANEL_URL=https://YOUR_HOST:8888
AAPANEL_API_KEY=
# PEM-серт панели (self-signed): без него не-loopback URL отвергается (анти-MITM)
AAPANEL_CA_BUNDLE=
# SSH-туннель к панели вместо whitelist по публичному IP (docs/v2/aapanel-tunnel-runbook.md).
# Включая: AAPANEL_TUNNEL=1, AAPANEL_URL=https://aapanel-tunnel:18839, AAPANEL_CA_BUNDLE обязателен.
AAPANEL_TUNNEL=
TUNNEL_VPS_HOST=
TUNNEL_VPS_USER=tunnel
TUNNEL_VPS_SSH_PORT=22
TUNNEL_PORT=18839
VPS_ORIGIN_IP=
# 1 = выпускать Cloudflare Origin CA на домен и ставить в aaPanel (нужны права токена SSL and
# Certificates: Edit и проверенная ручка SetSSL). Пусто/0 — CF во flexible, origin_https='none'.
ORIGIN_CA_AUTO=0

# --- LLM: LiteLLM (локально, OpenAI-совм., без ключа) ---
LLM_BASE_URL=http://192.168.1.77:4000
LLM_API_KEY=
LLM_MODEL=mistral                 # mistral(=mistral-large, платно у них) | mistral-small | ollama/<model>
# W5 (тема/язык прошлого сайта): пусто -> LLM_MODEL. На боксе — ollama/<модель> из /v1/models
LLM_CLASSIFY_MODEL=
LLM_CLASSIFY_FALLBACK_MODEL=      # запасная модель W5 при 401/403/404/429/5xx основной; пусто — без запасной
LLM_THINK=false                   # ollama/*: false -> think:false (ответ за ~1 с, не пустой); true — модель рассуждает

# --- Индексация (M5): GSC URL Inspection (основной) -> SearXNG site: (вспомогательный) ---
# GSC_SERVICE_ACCOUNT_JSON=      # JSON сервис-аккаунта целиком, одной строкой; аккаунт добавлен в свойство GSC сайта
# GSC_API_URL=https://searchconsole.googleapis.com
# INDEXNOW_ENABLED=true          # пинг IndexNow после публикации (ключ сайта = файл <key>.txt в корне сайта)
# INDEXNOW_SECRET=               # ОБЯЗАТЕЛЕН для IndexNow: ключ сайта = HMAC(секрет, домен); пусто — IndexNow выключен.
#                                # Любая длинная случайная строка (openssl rand -hex 32); после запуска не менять.
# INDEXNOW_URL=https://api.indexnow.org/indexnow

# --- Self-update (кнопка «Обновить из git» в панели) ---
GITHUB_REPO=kozhan-aff/combine_machine
GITHUB_TOKEN=                                # fine-grained PAT, Contents=Read-only

# --- Panel auth (Basic-auth на всю панель/API) ---
# Панель на LAN без иной защиты (docker-compose). Задай оба, чтобы /admin/pull и
# пайплайн не были доступны любому в сети. Пусто = auth ВЫКЛ (только localhost-dev).
PANEL_USER=
PANEL_PASS=
